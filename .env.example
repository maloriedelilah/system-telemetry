# ---------------------------------------------------------------------------
# system-telemetry per-machine config.  Copy to .env and edit.  NEVER commit .env.
# Same schema on Linux and Windows (msys/mingw bash).
# ---------------------------------------------------------------------------

# --- MQTT broker (homehub = HAOS Mosquitto) --------------------------------
# Leave MQTT_HOST EMPTY (but present) to turn MQTT off, e.g. on a box that only
# reports to Pane. If the line is missing altogether the old default applies.
MQTT_HOST=192.168.68.76
MQTT_PORT=1883
MQTT_USER=gpu-telemetry
MQTT_PASS=CHANGE_ME
# HA's discovery prefix is the DEFAULT "homeassistant" even though the instance
# is named cooperhome. Leave this unless you've changed it in HA.
MQTT_DISCOVERY_PREFIX=homeassistant

# --- Pane (VictoriaMetrics on the tailnet; second output, alongside MQTT) -----
# Base URL of Pane's vmauth, e.g. http://100.92.61.42:8427. Empty = Pane output off.
PANE_URL=
# File holding THIS box's bearer token (one line, nothing else). Chmod 0400, owned
# by the service user. The token is never read from the environment or .env, so it
# can't end up in `ps`, the journal or a repo; it is re-read every cycle, so a
# rotation needs no restart. Default if unset:
#   Linux   /opt/telemetry/secrets/pane_token
#   Windows C:\ProgramData\telemetry\secrets\pane_token
#PANE_TOKEN_FILE=
# Seconds to wait on Pane (per network operation) before giving up on this cycle.
PANE_TIMEOUT=10

# --- Identity --------------------------------------------------------------
# Friendly name used in entity ids/names. Defaults to the OS hostname if unset.
TELEMETRY_HOST_NAME=

# --- Roles: turn each collector on (1) or off (0) --------------------------
# nvidia-smi GPU metrics. 1 on any box with NVIDIA cards; 0 on Arc-only boxes.
TELEMETRY_NVIDIA=1
# LibreHardwareMonitor host stats (CPU/RAM/disk temps). Windows boxes with LHM.
TELEMETRY_LHM=0
# Include GPUs reported by LHM (for cards with no nvidia-smi, e.g. Arc B580).
# Leave 0 on NVIDIA boxes so their cards aren't double-published.
LHM_GPUS=0
# Linux host stats (CPU/RAM/disk) via psutil + lm-sensors. The Linux counterpart
# to TELEMETRY_LHM; ignored on Windows. NVMe temp works out of the box; SATA temps
# need `sudo modprobe drivetemp`.
TELEMETRY_HOST=0
# Probe the public sites in sites.txt and send their health to Pane (pane only).
TELEMETRY_SITES=0
# SITES_FILE=              # empty = the repo's sites.txt
# SITES_TIMEOUT=8          # seconds per socket operation, per site
# SITES_CONTROL_URL=https://www.google.com/generate_204   # if this fails too, pane lost the internet

# --- LibreHardwareMonitor (only if TELEMETRY_LHM=1) ------------------------
LHM_URL=http://localhost:8085/data.json
# Comma-separated GPU-name substrings to include (e.g. Arc). Empty = all GPUs.
LHM_GPU_INCLUDE=

# --- Loaded-model labels: ollama | lmstudio | docker | llamaserver | none --
# llamaserver = llama.cpp llama-server instances; MODEL_API_URL is then a
# comma-separated list of base URLs, e.g. http://127.0.0.1:1234,http://127.0.0.1:1235
# (each is asked GET /v1/models). One instance down doesn't hide the others.
MODEL_SOURCE=none
MODEL_API_URL=http://127.0.0.1:11434
MODEL_API_PATH=/api/v0/models
# Locality filter for LM Studio `lms link` cross-box leakage. Empty = all.
MODEL_FILTER=

# --- Runtime ---------------------------------------------------------------
# Set (seconds) for a long-running loop -> used by the Windows/NSSM service.
# LEAVE BLANK on Linux: the systemd timer handles cadence (single-shot runs).
LOOP_INTERVAL=
# 1 for verbose stderr.
DEBUG=0
